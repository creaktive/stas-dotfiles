# Host kindle
#     User            root

Host piano pianolizer pi.hole
    User            pi

Host sysd.org charles-carroll.dreamhost.com
    User            pusep

Host *
    ForwardAgent        yes
    # XAuthLocation       /opt/X11/bin/xauth
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster       auto
    ControlPath         ~/.ssh/cm-%C
    ControlPersist      4h
    AddKeysToAgent      yes
