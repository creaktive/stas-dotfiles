#!/bin/bash
AWS=aws
DATE=$(which gdate || which date)
JQ=jq

$DATE -d tomorrow &>/dev/null || { echo "Incompatible date command" >&2; exit 1; }

startTime=yesterday
endTime=now
limit=10000
groupNameFilter=lambda
describe=

ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            cat << HELP
Usage: aws-logs-query-all [options...] <query>
 -h, --help         This
 -f, --from         Search from timestamp (default: yesterday)
 -t, --to           Search to timestamp (default: now)
 -l, --limit        Results limit (default: 10000)
 -g, --group        Match group names to regex (default: lambda)
 -d, --describe     Describe non-empty matching groups and exit
HELP
            exit
            ;;
        -f|--from)
            startTime="$2"
            shift
            shift
            ;;
        -t|--to)
            endTime="$2"
            shift
            shift
            ;;
        -l|--limit)
            limit="$2"
            shift
            shift
            ;;
        -g|--group)
            groupNameFilter="$2"
            shift
            shift
            ;;
        -d|--describe)
            describe=1
            shift
            ;;
        -*|--*)
            echo "Unknown option $1" >&2
            exit 1
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

query="${ARGS[@]:-fields @timestamp, @message | filter @message like /^\{/ | sort @timestamp asc}"

startEpoch=$($DATE -d "$startTime" +%s) || exit 1
endEpoch=$($DATE -d "$endTime" +%s) || exit 1

# Groups created after the end time make the whole 50-group query fail with MalformedQueryException
groups=$($AWS logs describe-log-groups \
    | $JQ --arg filter "$groupNameFilter" --argjson endMs "${endEpoch}000" '
        .logGroups[]
        | select(
            (.storedBytes > 0) and
            (.creationTime <= $endMs) and
            (.logGroupName | test($filter))
        )
    ')

if [ -n "$describe" ]; then
    echo "$groups"
    exit
fi

if [ -z "$groups" ]; then
    echo "No log groups match '$groupNameFilter' in that time range" >&2
    exit 1
fi

failed=0
QUERIES=()
while read -r names; do
    queryId=$(
        $AWS logs start-query \
            --limit "$limit" \
            --start-time $startEpoch \
            --end-time $endEpoch \
            --log-group-names $names \
            --query-string "$query" \
            | $JQ -r .queryId
    )
    [ -z "$queryId" ] && { failed=1; continue; }
    QUERIES+=($queryId)
    echo $AWS logs get-query-results --query-id $queryId >&2
done < <($JQ -r .logGroupName <<< "$groups" | shuf | xargs -n 50)

for queryId in "${QUERIES[@]}"
do
    while true; do
        result=$($AWS logs get-query-results --query-id $queryId) || { failed=1; break; }
        status=$($JQ -r .status <<< "$result")
        case $status in
            Scheduled|Running)
                $JQ -c .statistics <<< "$result" >&2
                sleep 1
                ;;
            Complete)
                $JQ '
                    .results[]
                    | map({(.field | sub("\\W"; "_"; "g")): .value})
                    | add
                    | (._message | fromjson?) as $m
                    | {timestamp: ((._timestamp | sub(" "; "T") + "Z")? // $m.timestamp)} + ($m | del(.timestamp))
                ' <<< "$result"
                if $JQ -e '.statistics.resultCount >= 10000' <<< "$result" >/dev/null; then
                    echo "WARNING: query $queryId hit the 10000-row cap, results are truncated" >&2
                fi
                break
                ;;
            *)
                echo "Query $queryId ended with status: $status" >&2
                failed=1
                break
                ;;
        esac
    done
done

exit $failed
